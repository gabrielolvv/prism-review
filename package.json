{
  "name": "@gabrielolvv/prism-review",
  "version": "0.45.0",
  "description": "Reviews pull requests for risky changes before a human does: workflows, dependencies, infrastructure, secrets, code, and tests. A GitHub Action and a CLI.",
  "type": "module",
  "bin": {
    "prism-review": "./dist/cli/main.cjs"
  },
  "files": [
    "dist/cli/main.cjs",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "node scripts/bundle.mjs",
    "check": "npm run typecheck && npm run test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node build/tests/run-tests.js",
    "test:action": "npm run build && node build/tests/action/run-action-smoke.js",
    "analyze:fixture": "npm run bundle && node dist/cli/main.cjs analyze --fixture fixtures/diffs/risky-auth-change.diff"
  },
  "keywords": [
    "github-action",
    "pull-request",
    "code-review",
    "security",
    "supply-chain-security",
    "static-analysis",
    "cli",
    "ci"
  ],
  "author": "Gabriel Oliveira",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabrielolvv/prism-review.git"
  },
  "homepage": "https://github.com/gabrielolvv/prism-review#readme",
  "bugs": {
    "url": "https://github.com/gabrielolvv/prism-review/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "minimatch": "^10.0.1",
    "yaml": "^2.8.0",
    "zod": "^4.6.7",
    "@types/node": "^24.0.14",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.3"
  }
}
