{
  "name": "prism-review",
  "version": "0.3.0",
  "description": "A GitHub Action that reviews pull requests for risk signals before human review.",
  "type": "module",
  "private": true,
  "bin": {
    "prism-review": "./dist/cli/main.cjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "node scripts/bundle.mjs",
    "check": "npm run typecheck && npm run test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node build/tests/run-tests.js",
    "test:action": "npm run build && node build/tests/action/run-action-smoke.js",
    "analyze:fixture": "npm run bundle && node dist/cli/main.cjs analyze --fixture fixtures/diffs/risky-auth-change.diff"
  },
  "keywords": [
    "github-action",
    "pull-request",
    "code-review",
    "developer-tools",
    "ci"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "minimatch": "^10.0.1",
    "yaml": "^2.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.14",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.3"
  }
}
